# Production Environment Configuration
# Copy to .env for production deployment

# Application
VITE_API_URL=https://api.your-domain.com
NODE_ENV=production

# Google Sheets (if applicable)
VITE_GOOGLE_SHEETS_API_KEY=your-production-key
VITE_GOOGLE_SHEETS_SPREADSHEET_ID=your-production-spreadsheet-id

# Error Tracking & Monitoring
VITE_ERROR_REPORTING_URL=https://sentry.your-domain.com/...

# Security
VITE_SECURE_COOKIES=true
VITE_HTTPS_ONLY=true
VITE_CSP_ENABLED=true

# Logging
VITE_LOG_LEVEL=warn
VITE_LOG_TO_REMOTE=true

# Performance
VITE_ENABLE_ANALYTICS=true
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000
