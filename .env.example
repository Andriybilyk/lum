# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Google Sheets Integration
VITE_GOOGLE_SHEETS_API_KEY=your_google_api_key_here
VITE_GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# Error Reporting
VITE_ERROR_REPORTING_URL=https://error-tracking.example.com/api/errors

# Build Configuration
VITE_BUILD_ENV=development
